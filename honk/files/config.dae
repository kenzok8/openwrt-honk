global {
    wan_interface: auto
    lan_interface: br-lan
    log_level: info
    dial_mode: domain
    allow_insecure: false
    auto_config_kernel_parameter: true
    data_dir: '/etc/honk'
    store_subscribe: true
    nfqueue_enable: true
}

experimental {
    native_api {
        enabled: true
        listen: '127.0.0.1:9527'
        password_auth: true
        allow_anonymous_loopback: false
        config_write: true
        ui: '/usr/share/doona'
    }
}

group {
    proxy {
        policy: min_moving_avg
    }
}

dns {
    # 直连查询带上客户端网段，国内 CDN 才会返回就近地址
    client_subnet: auto
    upstream {
        default: 'https://223.5.5.5/dns-query?tls_server_name=dns.alidns.com' -> direct
        remote: 'https://8.8.8.8/dns-query?tls_server_name=dns.google' -> proxy
    }
    routing {
        request {
            qname(geosite: private) -> asis
            qname(geosite: cn) -> default
            fallback: remote
        }
        # 远端返回国内 IP 时也采信，避免两边解析结果不一致
        response {
            upstream(remote) -> accept
            qname(geosite: private) -> accept
            ip(geoip: cn) -> accept
            fallback: remote
        }
    }
}

routing {
    dip(224.0.0.0/3, 'ff00::/8') -> direct
    # 路由器自身地址直连，管理面板不被代理；服务启动时按本机地址重写下面区块
    # honk:local-direct-begin
    # honk:local-direct-end
    dip(geoip: private) && !dport(53) -> direct(must)
    dip(geoip: cn) && !dport(53) -> direct(must)
    domain(geosite: cn) -> direct
    # 这几类在 geosite: cn 里覆盖不全，单独列出
    domain(geosite: apple-cn) -> direct
    domain(geosite: category-games@cn) -> direct
    domain(geosite: steam@cn) -> direct
    domain(geosite: category-ai-cn) -> direct
    domain(geosite: onedrive) -> direct
    fallback: direct
}
