global {
    wan_interface: auto
    lan_interface: br-lan
    log_level: info
    dial_mode: domain
    allow_insecure: false
    auto_config_kernel_parameter: true
    data_dir: '/etc/honk'
    store_subscribe: false
    nfqueue_enable: true
}

experimental {
    clash_api {
        external_controller: '127.0.0.1:9527'
        external_ui: '/usr/share/honk-ui'
        secret: ''
    }
}
