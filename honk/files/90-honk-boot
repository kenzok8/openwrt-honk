#!/bin/sh
# 开机自启是内置行为：装上就 enable，是否真正启动由 honk.main.enabled 决定，
# 不再提供单独的 boot_enabled 开关。
/etc/init.d/honk enable

# Keep .lan/.local names working when the core's DNS controller intercepts port
# 53: send those suffixes to the default (SmartDNS) upstream. Older conffiles do
# not carry the rule; add it once. Without it a private-domain lookup falls
# through to the proxy/DoH fallback and answers NXDOMAIN on a box with no node.
if [ -f /etc/honk/config.dae ] && ! grep -q 'qname(suffix: lan)' /etc/honk/config.dae; then
	sed -i 's/^\([[:space:]]*\)qname(geosite: private) -> asis/\1qname(suffix: lan) -> default\n\1qname(suffix: local) -> default\n\1qname(geosite: private) -> asis/' /etc/honk/config.dae
fi

# The native API/UI (doona on port 9527) used to bind loopback only, so the
# controller page could not be opened from the LAN. system.dae is a conffile:
# upgrades keep the old copy, so rewrite it once here.
if [ -f /etc/honk/system.dae ] && grep -q "listen: '127.0.0.1:9527'" /etc/honk/system.dae; then
	sed -i "s/listen: '127\.0\.0\.1:9527'/listen: '0.0.0.0:9527'/" /etc/honk/system.dae
fi
exit 0
