+fn preview(request: Request) -> Result<serde_json::Value, &'static str> {
+    let root = Path::new(CONFIG_ROOT);
+    let entry = Path::new(CONFIG_ENTRY);
+    let current = load_sources(entry, &HashMap::new())?;
+    let source_sha256 = tree_sha256(root, &current.sources)?;
+    let revision = active_revision(Path::new(CONFIG_ROOT))?;
+    let candidate = build_candidate(&current, &request)?;
+    candidate
+        .loaded
+        .config
+        .validate_assembled()
+        .map_err(|_| "candidate_rejected")?;
+    let reloaded = load_sources(entry, &HashMap::new())?;
+    if tree_sha256(root, &reloaded.sources)? != source_sha256
+        || active_revision(Path::new(CONFIG_ROOT))? != revision
+    {
+        return Err("source_changed");
+    }
+
+    let preview_id = uuid::Uuid::new_v4().simple().to_string();
+    let preview_root = Path::new(PREVIEW_ROOT);
+    private_directory(preview_root)?;
+    remove_expired(preview_root);
+    let preview_dir = preview_root.join(&preview_id);
+    fs::create_dir(&preview_dir).map_err(|_| "preview_storage_unavailable")?;
+    fs::set_permissions(&preview_dir, fs::Permissions::from_mode(0o700))
+        .map_err(|_| "preview_storage_unavailable")?;
+    let files_root = preview_dir.join("files");
+    fs::create_dir(&files_root).map_err(|_| "preview_storage_unavailable")?;
+    fs::set_permissions(&files_root, fs::Permissions::from_mode(0o700))
+        .map_err(|_| "preview_storage_unavailable")?;
+
+    let mut changed_files = Vec::new();
+    for (path, content) in &candidate.changed {
+        let name = safe_source_name(root, path)?;
+        let file_path = preview_dir.join("files").join(&name);
+        create_private_parents(preview_dir.join("files"), Path::new(&name))?;
+        let mut file = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(&file_path)
+            .map_err(|_| "preview_storage_unavailable")?;
+        file.write_all(content.as_bytes())
+            .and_then(|()| file.sync_all())
+            .map_err(|_| "preview_storage_unavailable")?;
+        changed_files.push(ChangedFile {
+            name,
+            sha256: digest(content.as_bytes()),
+        });
+    }
+    write_candidate_tree(
+        &preview_dir.join("candidate/etc/honk"),
+        root,
+        &candidate.loaded.sources,
+    )?;
+    let candidate_sha256 = tree_sha256(root, &candidate.loaded.sources)?;
+    let record = PreviewRecord {
+        preview_id: preview_id.clone(),
+        source_sha256: source_sha256.clone(),
+        candidate_sha256,
+        revision,
+        kind: candidate.kind,
+        source_count: current.sources.len(),
+        changed_files,
+        imported_sections: candidate.imported_sections,
+        excluded_sections: candidate.excluded_sections,
+        replaced_sections: candidate.replaced_sections,
+        node_count: candidate.loaded.config.nodes.len(),
+        subscription_count: candidate.loaded.config.subscriptions.len(),
+        created_at: unix_time(),
+        runtime_validation: None,
+    };
+    let record_bytes = serde_json::to_vec(&record).map_err(|_| "preview_storage_unavailable")?;
+    let mut record_file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(preview_dir.join("record.json"))
+        .map_err(|_| "preview_storage_unavailable")?;
+    record_file
+        .write_all(&record_bytes)
+        .and_then(|()| record_file.sync_all())
+        .map_err(|_| "preview_storage_unavailable")?;
+    File::open(&preview_dir)
+        .and_then(|directory| directory.sync_all())
+        .map_err(|_| "preview_storage_unavailable")?;
+
+    Ok(preview_response(&record))
+}
+
+fn preview_response(record: &PreviewRecord) -> serde_json::Value {
+    let mock = match &record.runtime_validation {
+        Some(validation) => serde_json::json!({
+            "state": "passed",
+            "executed": &validation.executed,
+            "skipped": &validation.skipped,
+        }),
+        None => serde_json::json!({
+            "state": "skipped",
+            "reason": "isolated_runtime_not_run",
+        }),
+    };
+    serde_json::json!({
+        "ok": true,
+        "message": "preview_ready",
+        "preview_id": &record.preview_id,
+        "source_sha256": &record.source_sha256,
+        "revision": record.revision,
+        "source_count": record.source_count,
+        "changed_files": record.changed_files.len(),
+        "imported_sections": &record.imported_sections,
+        "excluded_sections": &record.excluded_sections,
+        "replaced_sections": &record.replaced_sections,
+        "node_count": record.node_count,
+        "subscription_count": record.subscription_count,
+        "parse": {"state": "passed"},
+        "config": {"state": "passed"},
+        "mock": mock,
+        "runtime": {"state": "not_applied"}
+    })
+}
+
+fn mark_validated(request: Request) -> Result<serde_json::Value, &'static str> {
+    let preview_id = request.preview_id.as_deref().ok_or("invalid_request")?;
+    if !valid_id(preview_id) {
+        return Err("invalid_preview_id");
+    }
+    let mut record = read_record(preview_id)?;
+    if request.source_sha256.as_deref() != Some(record.source_sha256.as_str()) {
+        return Err("source_changed");
+    }
+    verify_current_source(&record)?;
+    let candidate_root = preview_dir(preview_id).join("candidate/etc/honk");
+    let candidate = load_sources(&candidate_root.join("config.dae"), &HashMap::new())?;
+    if tree_sha256(&candidate_root, &candidate.sources)? != record.candidate_sha256 {
+        return Err("preview_corrupt");
+    }
+    if record.runtime_validation.is_none() {
+        record.runtime_validation = Some(RuntimeValidation {
+            executed: vec![
+                "parser".into(),
+                "assembled-config".into(),
+                "mock-backend-startup".into(),
+                "loopback-listeners-ready".into(),
+            ],
+            skipped: vec![
+                "subscription-fetch".into(),
+                "ECS-resolution".into(),
+                "health-and-node-probes".into(),
+                "geodata-refresh".into(),
+                "TCP-accept".into(),
+                "UDP-ingress".into(),
+                "kernel-network-setup".into(),
+                "external-network-reachability".into(),
+            ],
+        });
+        write_record(preview_id, &record)?;
+    }
+    Ok(preview_response(&record))
+}
+
+fn write_candidate_tree(
+    candidate_root: &Path,
+    source_root: &Path,
+    sources: &[SourceSnapshot],
+) -> Result<(), &'static str> {
+    fs::create_dir_all(candidate_root).map_err(|_| "preview_storage_unavailable")?;
+    fs::set_permissions(candidate_root, fs::Permissions::from_mode(0o700))
+        .map_err(|_| "preview_storage_unavailable")?;
+    for source in sources {
+        let name = safe_source_name(source_root, &source.path)?;
+        create_private_parents(candidate_root.to_path_buf(), Path::new(&name))?;
+        let path = candidate_root.join(&name);
+        let mut file = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(path)
+            .map_err(|_| "preview_storage_unavailable")?;
+        file.write_all(source.content.as_bytes())
+            .and_then(|()| file.sync_all())
+            .map_err(|_| "preview_storage_unavailable")?;
+    }
+    File::open(candidate_root)
+        .and_then(|directory| directory.sync_all())
+        .map_err(|_| "preview_storage_unavailable")?;
+    Ok(())
+}
+
+fn build_candidate(current: &LoadedConfig, request: &Request) -> Result<Candidate, &'static str> {
+    use honk_config::parser::source_edit::{
+        SubscriptionOptions, append_share_links_source, append_subscription_sources,
+        replace_business_sections_sources,
+    };
+
+    let root = current.sources.first().ok_or("invalid_current_config")?;
+    let (kind, edits, imported_sections, excluded_sections, replaced_sections) =
+        match (request.kind.as_deref(), request.mode.as_deref()) {
+            (Some("share_links"), None) => {
+                let raw = request.share_links.as_deref().ok_or("invalid_request")?;
+                if raw.len() > SHARE_LINK_LIMIT {
+                    return Err("share_links_too_large");
+                }
+                let links = raw
+                    .lines()
+                    .map(str::trim)
+                    .filter(|line| !line.is_empty())
+                    .map(str::to_owned)
+                    .collect::<Vec<_>>();
+                let (content, names) = append_share_links_source(&current.sources, &links)
+                    .map_err(|_| "share_links_invalid_or_conflicting")?;
+                (
+                    "share_links".to_owned(),
+                    vec![(root.path.clone(), content)],
+                    names,
+                    Vec::new(),
+                    Vec::new(),
+                )
+            }
+            (Some("subscription"), None) => {
+                let name = request.name.as_deref().ok_or("invalid_request")?;
+                let url = request.url.as_deref().ok_or("invalid_request")?;
+                if name.trim().is_empty() || name.len() > 256 || url.len() > 8192 {
+                    return Err("invalid_subscription");
+                }
+                let content = append_subscription_sources(
+                    &current.sources,
+                    name,
+                    url,
+                    &SubscriptionOptions::default(),
+                )
+                .map_err(|_| "subscription_invalid_or_conflicting")?;
+                (
+                    "subscription".to_owned(),
+                    vec![(root.path.clone(), content)],
+                    vec!["subscription".to_owned()],
+                    Vec::new(),
+                    Vec::new(),
+                )
+            }
+            (Some("dae"), Some("replace")) => {
+                let content = request.content.as_deref().ok_or("invalid_request")?;
+                if content.len() > DAE_LIMIT {
+                    return Err("dae_too_large");
+                }
+                let readonly = [PathBuf::from("/etc/honk/system.dae")];
+                let (edits, imported, excluded, replaced) =
+                    replace_business_sections_sources(&current.sources, &readonly, content)
+                        .map_err(|_| "dae_invalid_or_unsupported")?;
+                (
+                    "dae_replace".to_owned(),
+                    edits,
+                    imported,
+                    excluded,
+                    replaced,
+                )
+            }
+            _ => return Err("invalid_request"),
+        };
+
+    let mut overlay = current
+        .sources
+        .iter()
+        .map(|source| (source.path.clone(), Arc::clone(&source.content)))
+        .collect::<HashMap<_, _>>();
+    for (path, content) in &edits {
+        overlay.insert(path.clone(), Arc::from(content.as_str()));
+    }
+    let mut diagnostics: Vec<DetailedDiagnostic> = Vec::new();
+    let loaded = Config::from_dae_file_with_sources(
+        Path::new(CONFIG_ENTRY),
+        &overlay,
+        SourceLimits::DEFAULT,
+        &mut diagnostics,
+    )
+    .map_err(|_| "candidate_invalid")?;
+    loaded
+        .config
+        .validate_assembled()
+        .map_err(|_| "candidate_invalid")?;
+    let originals = current
+        .sources
+        .iter()
+        .map(|source| (source.path.clone(), source.content.as_ref()))
+        .collect::<HashMap<_, _>>();
+    let changed = loaded
+        .sources
+        .iter()
+        .filter(|source| {
+            originals
+                .get(&source.path)
+                .is_some_and(|old| *old != source.content.as_ref())
+        })
+        .map(|source| (source.path.clone(), source.content.to_string()))
+        .collect();
+    Ok(Candidate {
+        loaded,
+        changed,
+        kind,
+        imported_sections,
+        excluded_sections,
+        replaced_sections,
+    })
+}
+
+fn verify(request: Request) -> Result<serde_json::Value, &'static str> {
+    if request.kind.is_some()
+        || request.mode.is_some()
+        || request.name.is_some()
+        || request.url.is_some()
+        || request.share_links.is_some()
+        || request.content.is_some()
+        || request.upload_sha256.is_some()
+    {
+        return Err("invalid_request");
+    }
+    let preview_id = request.preview_id.as_deref().ok_or("invalid_request")?;
+    if !valid_id(preview_id) {
+        return Err("invalid_preview_id");
+    }
+    let record = read_record(preview_id)?;
+    if request.source_sha256.as_deref() != Some(record.source_sha256.as_str()) {
+        return Err("source_changed");
+    }
+    verify_current_source(&record)?;
+    for changed in &record.changed_files {
+        let files_root = preview_dir(preview_id).join("files");
+        validate_private_parents(&files_root, Path::new(&changed.name))?;
+        let path = files_root.join(&changed.name);
+        let metadata = fs::symlink_metadata(&path).map_err(|_| "preview_missing")?;
+        if !metadata.file_type().is_file()
+            || metadata.uid() != 0
+            || metadata.mode() & 0o777 != 0o600
+        {
+            return Err("preview_unsafe");
+        }
+        let bytes = fs::read(path).map_err(|_| "preview_missing")?;
+        if digest(&bytes) != changed.sha256 {
+            return Err("preview_corrupt");
+        }
+    }
+    Ok(
+        serde_json::json!({"ok": true, "message": "source_current", "source_sha256": record.source_sha256, "revision": record.revision}),
+    )
+}
+
+fn verify_validated(request: Request) -> Result<serde_json::Value, &'static str> {
+    let preview_id = request.preview_id.clone().ok_or("invalid_request")?;
+    if !valid_id(&preview_id) {
+        return Err("invalid_preview_id");
+    }
+    let verified = verify(request)?;
+    let record = read_record(&preview_id)?;
+    if record.runtime_validation.is_none() {
+        return Err("candidate_runtime_unvalidated");
+    }
+    Ok(verified)
+}
+
+fn verify_current_source(record: &PreviewRecord) -> Result<(), &'static str> {
+    let current = load_sources(Path::new(CONFIG_ENTRY), &HashMap::new())?;
+    if tree_sha256(Path::new(CONFIG_ROOT), &current.sources)? != record.source_sha256
+        || active_revision(Path::new(CONFIG_ROOT))? != record.revision
+    {
+        return Err("source_changed");
+    }
+    Ok(())
+}
+
+fn write_record(preview_id: &str, record: &PreviewRecord) -> Result<(), &'static str> {
+    if !valid_id(preview_id) || record.preview_id != preview_id {
+        return Err("invalid_preview_id");
+    }
+    validate_private_directory(Path::new(PREVIEW_ROOT))?;
+    let directory = preview_dir(preview_id);
+    validate_private_directory(&directory)?;
+    let record_path = directory.join("record.json");
+    let metadata = fs::symlink_metadata(&record_path).map_err(|_| "preview_missing")?;
+    if !metadata.file_type().is_file() || metadata.uid() != 0 || metadata.mode() & 0o777 != 0o600 {
+        return Err("preview_unsafe");
+    }
+    let temporary = directory.join(format!("record.{}.new", uuid::Uuid::new_v4().simple()));
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(&temporary)
+        .map_err(|_| "preview_storage_unavailable")?;
+    file.write_all(&serde_json::to_vec(record).map_err(|_| "preview_storage_unavailable")?)
+        .and_then(|()| file.sync_all())
+        .map_err(|_| "preview_storage_unavailable")?;
+    fs::rename(&temporary, &record_path).map_err(|_| "preview_storage_unavailable")?;
+    File::open(directory)
+        .and_then(|directory| directory.sync_all())
+        .map_err(|_| "preview_storage_unavailable")
+}
+
+#[cfg(feature = "native-api")]
+fn apply(request: Request) -> Result<serde_json::Value, &'static str> {
+    let preview_id = request.preview_id.as_deref().ok_or("invalid_request")?;
+    if !valid_id(preview_id) {
+        return Err("invalid_preview_id");
+    }
+    let record = read_record(preview_id)?;
+    if request.source_sha256.as_deref() != Some(record.source_sha256.as_str()) {
+        return Err("source_changed");
+    }
+    if record.runtime_validation.is_none() {
+        return Err("candidate_runtime_unvalidated");
+    }
+    let entry = Path::new(CONFIG_ENTRY);
+    let root = Path::new(CONFIG_ROOT);
+    let current = load_sources(entry, &HashMap::new())?;
+    if tree_sha256(root, &current.sources)? != record.source_sha256
+        || active_revision(root)? != record.revision
+    {
+        return Err("source_changed");
+    }
+    let originals = current
+        .sources
+        .iter()
+        .map(|source| (safe_source_name(root, &source.path).ok(), source))
+        .collect::<Vec<_>>();
+    let mut overlay = current
+        .sources
+        .iter()
+        .map(|source| (source.path.clone(), Arc::clone(&source.content)))
+        .collect::<HashMap<_, _>>();
+    let mut edits = Vec::new();
+    let mut seen = std::collections::HashSet::new();
+    for changed in &record.changed_files {
+        if !seen.insert(changed.name.as_str()) {
+            return Err("preview_corrupt");
+        }
+        validate_private_parents(
+            &preview_dir(preview_id).join("files"),
+            Path::new(&changed.name),
+        )?;
+        let source = originals
+            .iter()
+            .find(|(name, _)| name.as_deref() == Some(changed.name.as_str()))
+            .map(|(_, source)| *source)
+            .ok_or("preview_corrupt")?;
+        let path = preview_dir(preview_id).join("files").join(&changed.name);
+        let metadata = fs::symlink_metadata(&path).map_err(|_| "preview_missing")?;
+        if !metadata.file_type().is_file()
+            || metadata.uid() != 0
+            || metadata.mode() & 0o777 != 0o600
+        {
+            return Err("preview_unsafe");
+        }
+        let bytes = fs::read(&path).map_err(|_| "preview_missing")?;
+        if digest(&bytes) != changed.sha256 {
+            return Err("preview_corrupt");
+        }
+        let content = String::from_utf8(bytes).map_err(|_| "preview_corrupt")?;
+        overlay.insert(source.path.clone(), Arc::from(content.as_str()));
+        edits.push((source.path.clone(), source.content.to_string(), content));
+    }
+    let mut diagnostics: Vec<DetailedDiagnostic> = Vec::new();
+    let loaded = Config::from_dae_file_with_sources(
+        entry,
+        &overlay,
+        SourceLimits::DEFAULT,
+        &mut diagnostics,
+    )
+    .map_err(|_| "candidate_invalid")?;
+    loaded
+        .config
+        .validate_assembled()
+        .map_err(|_| "candidate_invalid")?;
+    require_apply_journal()?;
+    let state = StateDb::open_exclusive_for_admin(root).map_err(|_| "state_in_use")?;
+    let db = DbStore::open(Arc::new(state), entry).map_err(|_| "state_unavailable")?;
+    let head = db.head().map_err(|_| "state_unavailable")?;
+    if head != record.revision {
+        return Err("source_changed");
+    }
+    let pending = if head.is_some() {
+        Some(
+            db.stage(&loaded.sources, "luci", Origin::Import)
+                .map_err(|_| "candidate_invalid")?,
+        )
+    } else {
+        None
+    };
+    let candidate_sha256 = tree_sha256(root, &loaded.sources)?;
+    for (path, previous, content) in &edits {
+        replace_source(path, previous, content)?;
+    }
+    let applied = load_sources(entry, &HashMap::new())?;
+    if tree_sha256(root, &applied.sources)? != candidate_sha256 {
+        return Err("source_changed");
+    }
+    let committed = match pending {
+        Some(pending) => db.promote(pending).map_err(|_| "state_commit_failed")?,
+        None => db
+            .initialize_import(&applied.sources, "luci")
+            .map_err(|_| "state_commit_failed")?,
+    };
+    Ok(serde_json::json!({
+        "ok": true,
+        "message": "import_applied",
+        "revision": committed,
+        "runtime": {"state": "skipped", "reason": "service_start_validates_runtime"}
+    }))
+}
+
+#[cfg(feature = "native-api")]
+fn require_apply_journal() -> Result<(), &'static str> {
+    let directory = Path::new("/etc/.honk-maintenance");
+    let directory_metadata =
+        fs::symlink_metadata(directory).map_err(|_| "apply_journal_missing")?;
+    if !directory_metadata.file_type().is_dir()
+        || directory_metadata.uid() != 0
+        || directory_metadata.mode() & 0o777 != 0o700
+    {
+        return Err("apply_journal_invalid");
+    }
+    let path = directory.join("journal");
+    let mut file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW)
+        .open(&path)
+        .map_err(|_| "apply_journal_missing")?;
+    let metadata = file.metadata().map_err(|_| "apply_journal_invalid")?;
+    if !metadata.is_file()
+        || metadata.uid() != 0
+        || metadata.mode() & 0o777 != 0o600
+        || metadata.len() > 1024
+    {
+        return Err("apply_journal_invalid");
+    }
+    let mut content = String::new();
+    file.read_to_string(&mut content)
+        .map_err(|_| "apply_journal_invalid")?;
+    let operation = content
+        .lines()
+        .find_map(|line| line.strip_prefix("operation="));
+    let phase = content.lines().find_map(|line| line.strip_prefix("phase="));
+    let txn_id = content
+        .lines()
+        .find_map(|line| line.strip_prefix("txn_id="));
+    if operation != Some("import_apply")
+        || phase != Some("old_moved")
+        || !txn_id.is_some_and(valid_id)
+    {
+        return Err("apply_journal_invalid");
+    }
+    Ok(())
+}
+
+#[cfg(feature = "native-api")]
+fn replace_source(path: &Path, expected: &str, content: &str) -> Result<(), &'static str> {
+    let parent = validate_source_parent(path)?;
+    let metadata = fs::symlink_metadata(path).map_err(|_| "source_unavailable")?;
+    if !metadata.file_type().is_file() || metadata.uid() != 0 || metadata.mode() & 0o022 != 0 {
+        return Err("source_unsafe");
+    }
+    let mut original = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW)
+        .open(path)
+        .map_err(|_| "source_unavailable")?;
+    let opened = original.metadata().map_err(|_| "source_unavailable")?;
+    if opened.dev() != metadata.dev() || opened.ino() != metadata.ino() {
+        return Err("source_changed");
+    }
+    let mut bytes = Vec::new();
+    original
+        .read_to_end(&mut bytes)
+        .map_err(|_| "source_unavailable")?;
+    if bytes != expected.as_bytes() {
+        return Err("source_changed");
+    }
+    let temporary = parent.join(format!(
+        ".honk-import-{}.tmp",
+        uuid::Uuid::new_v4().simple()
+    ));
+    let mut output = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(&temporary)
+        .map_err(|_| "source_write_failed")?;
+    if output
+        .write_all(content.as_bytes())
+        .and_then(|()| output.sync_all())
+        .is_err()
+    {
+        let _ = fs::remove_file(&temporary);
+        return Err("source_write_failed");
+    }
+    let latest = fs::symlink_metadata(path).map_err(|_| "source_unavailable")?;
+    if latest.dev() != metadata.dev() || latest.ino() != metadata.ino() {
+        let _ = fs::remove_file(temporary);
+        return Err("source_changed");
+    }
+    if fs::rename(&temporary, path).is_err() {
+        let _ = fs::remove_file(&temporary);
+        return Err("source_write_failed");
+    }
+    File::open(parent)
+        .and_then(|directory| directory.sync_all())
+        .map_err(|_| "source_write_failed")
+}
+
+#[cfg(feature = "native-api")]
+fn validate_source_parent(path: &Path) -> Result<PathBuf, &'static str> {
+    let relative = path
+        .strip_prefix(CONFIG_ROOT)
+        .map_err(|_| "source_path_unsafe")?;
+    let mut components = relative.components().peekable();
+    let mut current = PathBuf::from(CONFIG_ROOT);
+    let root_metadata = fs::symlink_metadata(&current).map_err(|_| "source_unavailable")?;
+    if !root_metadata.file_type().is_dir()
+        || root_metadata.uid() != 0
+        || root_metadata.mode() & 0o022 != 0
+    {
+        return Err("source_unsafe");
+    }
+    while let Some(component) = components.next() {
+        let Component::Normal(name) = component else {
+            return Err("source_path_unsafe");
+        };
+        if components.peek().is_none() {
+            break;
+        }
+        current.push(name);
+        let metadata = fs::symlink_metadata(&current).map_err(|_| "source_unavailable")?;
+        if !metadata.file_type().is_dir() || metadata.uid() != 0 || metadata.mode() & 0o022 != 0 {
+            return Err("source_unsafe");
+        }
+    }
+    Ok(current)
+}
+
+fn discard(request: Request) -> Result<serde_json::Value, &'static str> {
+    let preview_id = request.preview_id.as_deref().ok_or("invalid_request")?;
+    if !valid_id(preview_id) {
+        return Err("invalid_preview_id");
+    }
+    let directory = preview_dir(preview_id);
+    let metadata = fs::symlink_metadata(&directory).map_err(|_| "preview_missing")?;
+    if !metadata.file_type().is_dir() || metadata.uid() != 0 || metadata.mode() & 0o777 != 0o700 {
+        return Err("preview_unsafe");
+    }
+    let files = directory.join("files");
+    let metadata = fs::symlink_metadata(&files).map_err(|_| "preview_missing")?;
+    if !metadata.file_type().is_dir() || metadata.uid() != 0 || metadata.mode() & 0o777 != 0o700 {
+        return Err("preview_unsafe");
+    }
+    fs::remove_dir_all(directory).map_err(|_| "preview_storage_unavailable")?;
+    Ok(serde_json::json!({"ok": true, "message": "preview_discarded"}))
+}
+
+fn prepare_upload() -> Result<serde_json::Value, &'static str> {
+    let root = Path::new(UPLOAD_ROOT);
+    private_directory(root)?;
+    let path = Path::new(UPLOAD_PATH);
+    match fs::symlink_metadata(path) {
+        Ok(metadata) => {
+            if !metadata.file_type().is_file()
+                || metadata.uid() != 0
+                || metadata.mode() & 0o777 != 0o600
+            {
+                return Err("dae_upload_unsafe");
+            }
+            fs::remove_file(path).map_err(|_| "dae_upload_unavailable")?;
+        }
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+        Err(_) => return Err("dae_upload_unavailable"),
+    }
+    File::open(root)
+        .and_then(|directory| directory.sync_all())
+        .map_err(|_| "dae_upload_unavailable")?;
+    Ok(serde_json::json!({"ok": true, "message": "upload_ready"}))
+}
+
+fn load_sources(
+    entry: &Path,
+    overlay: &HashMap<PathBuf, Arc<str>>,
+) -> Result<LoadedConfig, &'static str> {
+    Config::from_dae_file_with_sources(entry, overlay, SourceLimits::DEFAULT, &mut Vec::new())
+        .map_err(|_| "current_config_invalid")
+}
+
+fn read_uploaded_dae(expected_sha256: &str) -> Result<String, &'static str> {
+    let upload_root = Path::new(UPLOAD_ROOT);
+    validate_private_directory(upload_root).map_err(|_| "dae_upload_unsafe")?;
+    let root_before = fs::symlink_metadata(upload_root).map_err(|_| "dae_upload_unsafe")?;
+    let path = Path::new(UPLOAD_PATH);
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW)
+        .open(path)
+        .map_err(|_| "dae_upload_unavailable")?;
+    let metadata = file.metadata().map_err(|_| "dae_upload_unavailable")?;
+    if !metadata.is_file()
+        || metadata.uid() != 0
+        || metadata.mode() & 0o077 != 0
+        || metadata.len() > DAE_LIMIT as u64
+    {
+        return Err("dae_upload_invalid");
+    }
+    let mut bytes = Vec::with_capacity(metadata.len() as usize);
+    file.take((DAE_LIMIT + 1) as u64)
+        .read_to_end(&mut bytes)
+        .map_err(|_| "dae_upload_invalid")?;
+    let live = fs::symlink_metadata(path).map_err(|_| "dae_upload_unavailable")?;
+    let root_live = fs::symlink_metadata(upload_root).map_err(|_| "dae_upload_unsafe")?;
+    if live.dev() != metadata.dev()
+        || live.ino() != metadata.ino()
+        || root_live.dev() != root_before.dev()
+        || root_live.ino() != root_before.ino()
+        || root_live.uid() != 0
+        || root_live.mode() & 0o777 != 0o700
+        || !root_live.file_type().is_dir()
+    {
+        return Err("dae_upload_changed");
+    }
+    fs::remove_file(path).map_err(|_| "dae_upload_unavailable")?;
+    if bytes.len() > DAE_LIMIT {
+        return Err("dae_too_large");
+    }
+    if digest(&bytes) != expected_sha256 {
+        return Err("dae_upload_changed");
+    }
+    String::from_utf8(bytes).map_err(|_| "dae_upload_invalid")
+}
+
+fn tree_sha256(root: &Path, sources: &[SourceSnapshot]) -> Result<String, &'static str> {
+    let rows = sources
+        .iter()
+        .map(|source| {
+            Ok((
+                safe_source_name(root, &source.path)?,
+                digest(source.content.as_bytes()),
+            ))
+        })
+        .collect::<Result<Vec<_>, &'static str>>()?;
+    serde_json::to_vec(&rows)
+        .map(|bytes| digest(&bytes))
+        .map_err(|_| "source_hash_failed")
+}
+
+fn active_revision(root: &Path) -> Result<Option<i64>, &'static str> {
+    use rusqlite::{Connection, OpenFlags, OptionalExtension};
+
+    let state_dir = root.join("state");
+    let database = state_dir.join("honk.db");
+    let Ok(directory) = fs::symlink_metadata(&state_dir) else {
+        return Ok(None);
+    };
+    if !directory.file_type().is_dir() || directory.uid() != 0 || directory.mode() & 0o777 != 0o700
+    {
+        return Err("state_unsafe");
+    }
+    let Ok(metadata) = fs::symlink_metadata(&database) else {
+        return Ok(None);
+    };
+    if !metadata.file_type().is_file() || metadata.uid() != 0 || metadata.mode() & 0o777 != 0o600 {
+        return Err("state_unsafe");
+    }
+    let connection = Connection::open_with_flags(
+        &database,
+        OpenFlags::SQLITE_OPEN_READ_ONLY | OpenFlags::SQLITE_OPEN_NO_MUTEX,
+    )
+    .map_err(|_| "state_unavailable")?;
+    let application_id: i64 = connection
+        .pragma_query_value(None, "application_id", |row| row.get(0))
+        .map_err(|_| "state_unsupported")?;
+    let schema_version: i64 = connection
+        .pragma_query_value(None, "user_version", |row| row.get(0))
+        .map_err(|_| "state_unsupported")?;
+    if application_id != crate::state::APPLICATION_ID
+        || schema_version != crate::state::SCHEMA_VERSION
+    {
+        return Err("state_unsupported");
+    }
+    let revision_count: i64 = connection
+        .query_row("SELECT count(*) FROM revision", [], |row| row.get(0))
+        .map_err(|_| "state_unsupported")?;
+    let active = connection
+        .query_row("SELECT active FROM head WHERE id=1", [], |row| row.get(0))
+        .optional()
+        .map_err(|_| "state_unsupported")?;
+    if (revision_count > 0) != active.is_some() {
+        return Err("state_corrupt");
+    }
+    Ok(active)
+}
+
+fn safe_source_name(root: &Path, path: &Path) -> Result<String, &'static str> {
+    let relative = path.strip_prefix(root).map_err(|_| "source_outside_root")?;
+    if relative.as_os_str().is_empty()
+        || relative
+            .components()
+            .any(|component| !matches!(component, Component::Normal(_)))
+    {
+        return Err("source_path_unsafe");
+    }
+    let name = relative.to_str().ok_or("source_path_unsafe")?;
+    if name
+        .bytes()
+        .any(|byte| byte.is_ascii_control() || byte == b'\\')
+    {
+        return Err("source_path_unsafe");
+    }
+    Ok(name.to_owned())
+}
+
+fn preview_dir(preview_id: &str) -> PathBuf {
+    Path::new(PREVIEW_ROOT).join(preview_id)
+}
+
+fn read_record(preview_id: &str) -> Result<PreviewRecord, &'static str> {
+    let root = Path::new(PREVIEW_ROOT);
+    let metadata = fs::symlink_metadata(root).map_err(|_| "preview_missing")?;
+    if !metadata.file_type().is_dir() || metadata.uid() != 0 || metadata.mode() & 0o777 != 0o700 {
+        return Err("preview_unsafe");
+    }
+    let directory = preview_dir(preview_id);
+    let metadata = fs::symlink_metadata(&directory).map_err(|_| "preview_missing")?;
+    if !metadata.file_type().is_dir() || metadata.uid() != 0 || metadata.mode() & 0o777 != 0o700 {
+        return Err("preview_unsafe");
+    }
+    let path = directory.join("record.json");
+    let metadata = fs::symlink_metadata(&path).map_err(|_| "preview_missing")?;
+    if !metadata.file_type().is_file() || metadata.uid() != 0 || metadata.mode() & 0o777 != 0o600 {
+        return Err("preview_unsafe");
+    }
+    let record: PreviewRecord =
+        serde_json::from_slice(&fs::read(path).map_err(|_| "preview_missing")?)
+            .map_err(|_| "preview_corrupt")?;
+    if record.preview_id != preview_id
+        || unix_time().saturating_sub(record.created_at) > PREVIEW_TTL.as_secs()
+    {
+        return Err("preview_expired");
+    }
+    Ok(record)
+}
+
+fn private_directory(path: &Path) -> Result<(), &'static str> {
+    match fs::create_dir(path) {
+        Ok(()) => fs::set_permissions(path, fs::Permissions::from_mode(0o700))
+            .map_err(|_| "preview_storage_unavailable")?,
+        Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {}
+        Err(_) => return Err("preview_storage_unavailable"),
+    }
+    validate_private_directory(path)
+}
+
+fn validate_private_directory(path: &Path) -> Result<(), &'static str> {
+    let metadata = fs::symlink_metadata(path).map_err(|_| "preview_storage_unavailable")?;
+    if !metadata.file_type().is_dir() || metadata.uid() != 0 || metadata.mode() & 0o777 != 0o700 {
+        return Err("preview_storage_unsafe");
+    }
+    Ok(())
+}
+
+fn create_private_parents(root: PathBuf, relative: &Path) -> Result<(), &'static str> {
+    let mut current = root;
+    for component in relative.parent().into_iter().flat_map(Path::components) {
+        let Component::Normal(component) = component else {
+            return Err("source_path_unsafe");
+        };
+        current.push(component);
+        match fs::create_dir(&current) {
+            Ok(()) => fs::set_permissions(&current, fs::Permissions::from_mode(0o700))
+                .map_err(|_| "preview_storage_unavailable")?,
+            Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {}
+            Err(_) => return Err("preview_storage_unavailable"),
+        }
+        let metadata = fs::symlink_metadata(&current).map_err(|_| "preview_storage_unavailable")?;
+        if !metadata.file_type().is_dir() || metadata.uid() != 0 || metadata.mode() & 0o777 != 0o700
+        {
+            return Err("preview_storage_unsafe");
+        }
+    }
+    Ok(())
+}
+
+fn validate_private_parents(root: &Path, relative: &Path) -> Result<(), &'static str> {
+    validate_private_directory(root)?;
+    let mut current = root.to_path_buf();
+    for component in relative.parent().into_iter().flat_map(Path::components) {
+        let Component::Normal(component) = component else {
+            return Err("source_path_unsafe");
+        };
+        current.push(component);
+        validate_private_directory(&current)?;
+    }
+    Ok(())
+}
+
+fn remove_expired(root: &Path) {
+    let Ok(entries) = fs::read_dir(root) else {
+        return;
+    };
+    for entry in entries.flatten() {
+        let path = entry.path();
+        let Ok(metadata) = fs::symlink_metadata(&path) else {
+            continue;
+        };
+        if !metadata.file_type().is_dir()
+            || metadata.uid() != 0
+            || metadata.mode() & 0o777 != 0o700
+            || metadata
+                .modified()
+                .ok()
+                .and_then(|time| time.elapsed().ok())
+                .is_none_or(|age| age <= PREVIEW_TTL)
+        {
+            continue;
+        }
+        let _ = fs::remove_dir_all(path);
+    }
+}
+
+fn valid_id(value: &str) -> bool {
+    value.len() == 32
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+fn unix_time() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |time| time.as_secs())
+}
