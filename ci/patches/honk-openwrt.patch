+fn reset_default_revision(
+    path: &std::path::Path,
+    revision_root: Option<&std::path::Path>,
+) -> anyhow::Result<state::DefaultRevision> {
+    #[derive(serde::Serialize)]
+    struct StoredSource {
+        name: String,
+        parent: Option<usize>,
+        content: String,
+        sha256: String,
+    }
+
+    let source_root = path
+        .parent()
+        .ok_or_else(|| anyhow::anyhow!("default configuration has no parent directory"))?;
+    let stored_root = revision_root.unwrap_or(source_root);
+    let mut diagnostics = Vec::new();
+    let loaded = Config::from_dae_file_with_sources(
+        path,
+        &std::collections::HashMap::new(),
+        honk_config::parser::SourceLimits::DEFAULT,
+        &mut diagnostics,
+    )?;
+    loaded.config.validate_assembled()?;
+    let mut bytes = 0usize;
+    let sources = loaded
+        .sources
+        .iter()
+        .map(|source| {
+            let name = source
+                .path
+                .strip_prefix(source_root)
+                .ok()
+                .and_then(std::path::Path::to_str)
+                .ok_or_else(|| {
+                    anyhow::anyhow!("default configuration source is outside its root")
+                })?;
+            let content = honk_config::parser::source_edit::strip_listener_secrets(&source.content)
+                .map_err(|_| anyhow::anyhow!("default configuration secrets cannot be isolated"))?;
+            bytes = bytes.saturating_add(content.len());
+            Ok(StoredSource {
+                name: name.to_owned(),
+                parent: source.parent,
+                sha256: configuration::digest(content.as_bytes()),
+                content,
+            })
+        })
+        .collect::<anyhow::Result<Vec<_>>>()?;
+    let sources = serde_json::to_string(&sources)?;
+    anyhow::ensure!(
+        bytes <= honk_config::parser::SourceLimits::DEFAULT.max_bytes,
+        "default configuration exceeds the source limit"
+    );
+    Ok(state::DefaultRevision {
+        root: stored_root
+            .to_str()
+            .ok_or_else(|| anyhow::anyhow!("default configuration root is not UTF-8"))?
+            .to_owned(),
+        content_sha256: configuration::digest(sources.as_bytes()),
+        sources,
+        bytes: i64::try_from(bytes)?,
+    })
+}
