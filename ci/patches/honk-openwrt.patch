+#[test]
+fn business_reset_refuses_unknown_schema_and_active_state_owners() {
+    let data = tempfile::tempdir().unwrap();
+    let state = StateDb::open(data.path()).unwrap();
+    assert_eq!(
+        reset_business_state(data.path(), Some(&reset_revision())),
+        Err(StateError::InUse)
+    );
+    drop(state);
+    let connection = Connection::open(db_path(data.path())).unwrap();
+    connection
+        .execute_batch("CREATE TABLE unexpected (value TEXT);")
+        .unwrap();
+    drop(connection);
+    assert_eq!(
+        reset_business_state(data.path(), Some(&reset_revision())),
+        Err(StateError::Unsupported)
+    );
+}
+
+#[test]
+fn business_reset_accepts_a_valid_database_without_admin_or_listener_secrets() {
+    let data = tempfile::tempdir().unwrap();
+    drop(StateDb::open(data.path()).unwrap());
+    assert!(reset_business_state(data.path(), Some(&reset_revision())).unwrap());
+    let state = StateDb::open(data.path()).unwrap();
+    let connection = state.strict();
+    assert_eq!(
+        connection
+            .query_row("SELECT count(*) FROM admin", [], |row| row.get::<_, i64>(0))
+            .unwrap(),
+        0
+    );
+    assert_eq!(
+        connection
+            .query_row("SELECT count(*) FROM listener_secret", [], |row| row
+                .get::<_, i64>(0))
+            .unwrap(),
+        0
+    );
+}
