+/// Replace business sections across a complete loaded tree. Read-only source
+/// paths are retained and rejected if they contain business sections.
+pub fn replace_business_sections_sources(
+    sources: &[SourceSnapshot],
+    read_only_paths: &[std::path::PathBuf],
+    imported: &str,
+) -> Result<
+    (
+        Vec<(std::path::PathBuf, String)>,
+        Vec<String>,
+        Vec<String>,
+        Vec<(String, usize)>,
+    ),
+    SourceEditError,
+> {
+    let source = sources.first().ok_or(SourceEditError)?;
+    if imported.len() > 2 * 1024 * 1024 {
+        return Err(SourceEditError);
+    }
+    let imported_path = source.path.with_file_name("honk-import.dae");
+    let imported_config = super::parse_dae_sources(
+        &[(imported_path, std::sync::Arc::from(imported))],
+        super::SourceLimits::default(),
+        &mut Vec::new(),
+    )
+    .map_err(|_| SourceEditError)?;
+    let imported_source = &imported_config.sources[0];
+    let imported_document = managed_document(imported_source)?;
+    let roots = imported_document.sections().collect::<Vec<_>>();
+    if roots.iter().any(|root| root.header() == "include") {
+        return Err(SourceEditError);
+    }
+
+    let mut accepted = Vec::new();
+    let mut accepted_names = Vec::new();
+    let mut excluded = Vec::new();
+    for root in roots {
+        let name = root.header();
+        if BUSINESS_ROOTS.contains(&name) {
+            let span = root.span();
+            accepted.push(imported[span.start..span.end].to_owned());
+            accepted_names.push(name.to_owned());
+        } else if !excluded.iter().any(|existing| existing == name) {
+            excluded.push(name.to_owned());
+        }
+    }
+    if accepted.is_empty() {
+        return Err(SourceEditError);
+    }
+
+    let mut outputs = Vec::with_capacity(sources.len());
+    let mut replaced = std::collections::HashMap::<String, usize>::new();
+    for source in sources {
+        let document = managed_document(source)?;
+        let roots = document
+            .sections()
+            .filter(|root| BUSINESS_ROOTS.contains(&root.header()))
+            .collect::<Vec<_>>();
+        for root in &roots {
+            *replaced.entry(root.header().to_owned()).or_default() += 1;
+        }
+        if read_only_paths.contains(&source.path) {
+            if !roots.is_empty() {
+                return Err(SourceEditError);
+            }
+            outputs.push((source.path.clone(), source.content.to_string()));
+            continue;
+        }
+        let removals = roots
+            .iter()
+            .map(|root| line_of(&source.content, root.span().start..root.span().end))
+            .collect::<Vec<_>>();
+        let mut content = source.content.to_string();
+        for range in removals.into_iter().rev() {
+            content.replace_range(range, "");
+        }
+        outputs.push((source.path.clone(), content));
+    }
+    let (_, content) = outputs.first_mut().ok_or(SourceEditError)?;
+    if !accepted.is_empty() {
+        if !content.is_empty() && !content.ends_with('\n') {
+            content.push('\n');
+        }
+        if !content.is_empty() && !content.ends_with("\n\n") {
+            content.push('\n');
+        }
+        content.push_str(&accepted.join("\n\n"));
+        if !content.ends_with('\n') {
+            content.push('\n');
+        }
+    }
+    let mut replaced = replaced.into_iter().collect::<Vec<_>>();
+    replaced.sort_by(|left, right| left.0.cmp(&right.0));
+    Ok((outputs, accepted_names, excluded, replaced))
+}
