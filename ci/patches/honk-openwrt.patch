+#[tokio::test]
+async fn offline_validation_skips_missing_subscription_bodies_without_fetching() {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let provider = authorized(
+        uuid::Uuid::new_v4(),
+        1,
+        format!("http://{}", listener.local_addr().unwrap()),
+    );
+    let mut config = Config {
+        subscriptions: vec![provider.subscription.clone()],
+        ..Default::default()
+    };
+    let mut state = SupervisorState::new_with_offline_validation(
+        Arc::new(SubscriptionManager::new().unwrap()),
+        None,
+        true,
+    );
+    state.reconcile(vec![provider]);
+
+    let diagnostics = tokio::time::timeout(
+        Duration::from_millis(100),
+        state.prepare_startup(&mut config, Vec::new()),
+    )
+    .await
+    .expect("offline startup must not wait for a fetch");
+
+    assert!(diagnostics.providers.is_empty());
+    assert!(state.pending.is_empty());
+    assert!(state.fetches.is_empty());
+    assert!(
+        tokio::time::timeout(Duration::from_millis(25), listener.accept())
+            .await
+            .is_err()
+    );
+    state.shutdown().await.unwrap();
+}
