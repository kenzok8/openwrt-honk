+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn request_rejects_arbitrary_paths_sql_and_unknown_fields() {
+        for input in [
+            r#"{"action":"preview","kind":"dae","path":"/etc/passwd"}"#,
+            r#"{"action":"preview","kind":"dae","sql":"DELETE FROM admin"}"#,
+            r#"{"action":"preview","kind":"dae","unknown":true}"#,
+        ] {
+            assert!(serde_json::from_str::<Request>(input).is_err());
+        }
+    }
+
+    #[test]
+    fn preview_shape_rejects_path_fields_and_requires_fixed_import_fields() {
+        let valid = Request {
+            action: "preview".into(),
+            kind: Some("subscription".into()),
+            mode: None,
+            name: Some("feed".into()),
+            url: Some("https://example.invalid/list".into()),
+            share_links: None,
+            content: None,
+            upload_sha256: None,
+            preview_id: None,
+            source_sha256: None,
+        };
+        assert!(validate_preview_shape(&valid).is_ok());
+
+        let mut with_share_links = valid;
+        with_share_links.share_links = Some("file:///etc/passwd".into());
+        assert!(validate_preview_shape(&with_share_links).is_err());
+    }
+
+    #[test]
+    fn request_limits_match_the_advertised_transport_bounds() {
+        assert_eq!(SHARE_LINK_LIMIT, 16 * 1024);
+        assert_eq!(DAE_LIMIT, 2 * 1024 * 1024);
+        assert!(REQUEST_LIMIT > DAE_LIMIT);
+    }
+}
