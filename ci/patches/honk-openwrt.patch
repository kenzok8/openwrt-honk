+}
+
+pub(crate) fn run(cli: &crate::Cli) -> anyhow::Result<()> {
+    let mut input = Vec::new();
+    let read_result = std::io::stdin()
+        .take((REQUEST_LIMIT + 1) as u64)
+        .read_to_end(&mut input);
+    let result = read_result.map_err(|_| "invalid_request").and_then(|_| {
+        if input.len() > REQUEST_LIMIT {
+            return Err("request_too_large");
+        }
+        let mut request: Request = serde_json::from_slice(&input).map_err(|_| "invalid_request")?;
+        if request.action == "preview" && request.kind.as_deref() == Some("dae") {
+            if request.content.is_some() {
+                return Err("invalid_request");
+            }
+            let expected_sha256 = request.upload_sha256.as_deref().ok_or("invalid_request")?;
+            if expected_sha256.len() != 64
+                || !expected_sha256.bytes().all(|byte| byte.is_ascii_hexdigit())
+            {
+                return Err("invalid_request");
+            }
+            request.content = Some(read_uploaded_dae(expected_sha256)?);
+            request.upload_sha256 = None;
+        }
+        run_request(cli, request)
+    });
+    match result {
+        Ok(response) => println!("{response}"),
+        Err(message) => println!("{}", serde_json::json!({"ok": false, "message": message})),
+    }
+    Ok(())
+}
+
+fn run_request(cli: &crate::Cli, request: Request) -> Result<serde_json::Value, &'static str> {
+    if cli.config != Path::new(CONFIG_ENTRY) || cli.data_dir != Path::new(CONFIG_ROOT) {
+        return Err("unsupported_runtime_paths");
+    }
+    match request.action.as_str() {
+        "upload_prepare"
+            if request.kind.is_none()
+                && request.mode.is_none()
+                && request.name.is_none()
+                && request.url.is_none()
+                && request.share_links.is_none()
+                && request.content.is_none()
+                && request.upload_sha256.is_none()
+                && request.preview_id.is_none()
+                && request.source_sha256.is_none() =>
+        {
+            prepare_upload()
+        }
+        "preview" => {
+            validate_preview_shape(&request)?;
+            preview(request)
+        }
+        "mark_validated"
+            if request.kind.is_none()
+                && request.mode.is_none()
+                && request.name.is_none()
+                && request.url.is_none()
+                && request.share_links.is_none()
+                && request.content.is_none()
+                && request.upload_sha256.is_none() =>
+        {
+            mark_validated(request)
+        }
+        #[cfg(feature = "native-api")]
+        "apply"
+            if request.kind.is_none()
+                && request.mode.is_none()
+                && request.name.is_none()
+                && request.url.is_none()
+                && request.share_links.is_none()
+                && request.content.is_none()
+                && request.upload_sha256.is_none() =>
+        {
+            apply(request)
+        }
+        #[cfg(not(feature = "native-api"))]
+        "apply" => Err("unsupported_core"),
+        "verify" => verify(request),
+        "verify_validated" => verify_validated(request),
+        "discard" => discard(request),
+        _ => Err("invalid_action"),
+    }
+}
+
+fn validate_preview_shape(request: &Request) -> Result<(), &'static str> {
+    match (request.kind.as_deref(), request.mode.as_deref()) {
+        (Some("share_links"), None)
+            if request.name.is_none()
+                && request.url.is_none()
+                && request.content.is_none()
+                && request.preview_id.is_none()
+                && request.source_sha256.is_none()
+                && request.upload_sha256.is_none() =>
+        {
+            Ok(())
+        }
+        (Some("subscription"), None)
+            if request.name.is_some()
+                && request.url.is_some()
+                && request.share_links.is_none()
+                && request.content.is_none()
+                && request.preview_id.is_none()
+                && request.source_sha256.is_none()
+                && request.upload_sha256.is_none() =>
+        {
+            Ok(())
+        }
+        (Some("dae"), Some("replace"))
+            if request.name.is_none()
+                && request.url.is_none()
+                && request.share_links.is_none()
+                && request.content.is_some()
+                && request.preview_id.is_none()
+                && request.source_sha256.is_none()
+                && request.upload_sha256.is_none() =>
+        {
+            Ok(())
+        }
+        _ => Err("invalid_request"),
+    }
+}
