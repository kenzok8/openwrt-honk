+#[test]
+fn share_link_batch_import_uses_the_core_parser_and_rejects_collisions() {
+    let loaded = managed_source("node { existing: 'socks5://127.0.0.1:1080' }\n");
+    let links = vec![
+        "trojan://secret@example.test:443#first".to_owned(),
+        "vless://00000000-0000-0000-0000-000000000001@example.test:8443#second".to_owned(),
+    ];
+    let (edited, names) = append_share_links_source(&loaded.sources, &links).unwrap();
+    assert_eq!(names, ["first", "second"]);
+    let candidate = managed_source(&edited);
+    assert_eq!(candidate.config.nodes.len(), 3);
+    assert_eq!(candidate.config.nodes[1].name, "first");
+    assert_eq!(candidate.config.nodes[2].name, "second");
+
+    let duplicate = vec![
+        "trojan://secret@example.test:443#duplicate".to_owned(),
+        "socks5://user:pass@127.0.0.1:1080#duplicate".to_owned(),
+    ];
+    let error = append_share_links_source(&loaded.sources, &duplicate).unwrap_err();
+    assert!(!format!("{error:?} {error}").contains("secret"));
+    assert!(append_share_links_source(&loaded.sources, &["unknown://secret".to_owned()]).is_err());
+
+    let root = PathBuf::from("/config/main.dae");
+    let child = PathBuf::from("/config/system.dae");
+    let tree = crate::parser::load_dae_sources_in_memory(
+        &root,
+        &[
+            (
+                root.clone(),
+                Arc::from("include { 'system.dae' }\nnode { root: 'socks5://127.0.0.1:1081' }\n"),
+            ),
+            (
+                child,
+                Arc::from("node { child: 'socks5://127.0.0.1:1082' }\n"),
+            ),
+        ]
+        .into_iter()
+        .collect(),
+        SourceLimits::default(),
+        &mut Vec::new(),
+    )
+    .unwrap();
+    let child_collision = vec!["socks5://127.0.0.1:1082#new".to_owned()];
+    assert!(append_share_links_source(&tree.sources, &child_collision).is_err());
+}
