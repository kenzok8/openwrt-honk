+/// Append share links with the production parser, preserving the source's
+/// formatting and refusing duplicate names or parser-derived identities.
+pub fn append_share_links_source(
+    sources: &[SourceSnapshot],
+    links: &[String],
+) -> Result<(String, Vec<String>), SourceEditError> {
+    let source = sources.first().ok_or(SourceEditError)?;
+    if links.is_empty()
+        || links.len() > 1000
+        || links.iter().map(String::len).sum::<usize>() > 1024 * 1024
+    {
+        return Err(SourceEditError);
+    }
+    let inputs = sources
+        .iter()
+        .map(|source| (source.path.clone(), source.content.clone()))
+        .collect::<Vec<_>>();
+    let existing =
+        super::parse_dae_sources(&inputs, super::SourceLimits::default(), &mut Vec::new())
+            .map_err(|_| SourceEditError)?;
+    let mut names = std::collections::HashSet::new();
+    let mut ids = existing
+        .config
+        .nodes
+        .iter()
+        .map(|node| node.id)
+        .collect::<std::collections::HashSet<_>>();
+    let mut entries = Vec::with_capacity(links.len());
+    let mut imported_names = Vec::with_capacity(links.len());
+    for link in links {
+        let mut diagnostics = Vec::new();
+        let node =
+            crate::node::Node::from_share_link_with_detailed_diagnostics(link, &mut diagnostics)
+                .map_err(|_| SourceEditError)?;
+        if node.name.trim().is_empty() {
+            return Err(SourceEditError);
+        }
+        let id = node.derive_id();
+        if existing
+            .config
+            .nodes
+            .iter()
+            .any(|existing| existing.name == node.name)
+            || !names.insert(node.name.clone())
+            || !ids.insert(id)
+        {
+            return Err(SourceEditError);
+        }
+        let (entry, parsed) = managed_entry("node", &node.name, link, &[])?;
+        if parsed.nodes.len() != 1 || parsed.nodes[0].id != id {
+            return Err(SourceEditError);
+        }
+        entries.push(entry);
+        imported_names.push(node.name);
+    }
+    let document = managed_document(source)?;
+    Ok((append_entries(&document, "node", &entries), imported_names))
+}
