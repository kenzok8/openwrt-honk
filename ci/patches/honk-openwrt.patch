+fn offline_candidate_root(cli: &Cli) -> anyhow::Result<PathBuf> {
+    anyhow::ensure!(cli.mock_ebpf, "offline validation requires --mock-ebpf");
+    anyhow::ensure!(
+        cli.store == ConfigStore::File,
+        "offline validation requires the file store"
+    );
+    anyhow::ensure!(
+        cli.log_file.is_none(),
+        "offline validation does not accept --log-file"
+    );
+    anyhow::ensure!(
+        cli.bpf_object.is_none(),
+        "offline validation does not accept --bpf-object"
+    );
+    anyhow::ensure!(
+        cli.data_dir == PathBuf::from(honk_config::paths::DEFAULT_DATA_DIR),
+        "offline validation does not accept --data-dir"
+    );
+    let config_dir = cli
+        .config
+        .parent()
+        .ok_or_else(|| anyhow::anyhow!("offline config has no parent"))?;
+    anyhow::ensure!(
+        cli.config
+            .file_name()
+            .is_some_and(|name| name == "config.dae")
+    );
+    anyhow::ensure!(config_dir.file_name().is_some_and(|name| name == "honk"));
+    let etc = config_dir
+        .parent()
+        .ok_or_else(|| anyhow::anyhow!("offline config has no etc directory"))?;
+    anyhow::ensure!(etc.file_name().is_some_and(|name| name == "etc"));
+    let shadow = etc
+        .parent()
+        .ok_or_else(|| anyhow::anyhow!("offline config has no shadow root"))?;
+    anyhow::ensure!(shadow.file_name().is_some_and(|name| name == "shadow"));
+    let private_root = shadow
+        .parent()
+        .ok_or_else(|| anyhow::anyhow!("offline config has no private root"))?;
+    anyhow::ensure!(
+        private_root.parent() == Some(Path::new("/tmp"))
+            && private_root
+                .file_name()
+                .is_some_and(|name| name.to_string_lossy().starts_with("honk-maint.")),
+        "offline validation requires a private Honk maintenance shadow"
+    );
+    for path in [
+        private_root,
+        shadow,
+        etc,
+        config_dir,
+        &private_root.join("shadow-data"),
+    ] {
+        let metadata = std::fs::symlink_metadata(path)?;
+        anyhow::ensure!(
+            metadata.file_type().is_dir() && metadata.uid() == 0 && metadata.mode() & 0o077 == 0,
+            "offline validation directory is not private"
+        );
+    }
+    let entry = std::fs::symlink_metadata(&cli.config)?;
+    anyhow::ensure!(
+        entry.file_type().is_file()
+            && entry.uid() == 0
+            && entry.mode() & 0o077 == 0
+            && std::fs::canonicalize(&cli.config)?.starts_with(private_root),
+        "offline entry configuration is not a private file"
+    );
+    let tmp_metadata = std::fs::symlink_metadata("/tmp")?;
+    anyhow::ensure!(
+        tmp_metadata.file_type().is_dir()
+            && tmp_metadata.uid() == 0
+            && tmp_metadata.mode() & 0o1000 != 0,
+        "offline validation requires the system temporary directory"
+    );
+    Ok(private_root.to_path_buf())
+}
+
+#[cfg(feature = "native-api")]
+fn validate_offline_sources(
+    root: &Path,
+    sources: &[honk_config::parser::SourceSnapshot],
+) -> anyhow::Result<()> {
+    let config_root = root.join("shadow/etc/honk");
+    let config_root = std::fs::canonicalize(config_root)?;
+    anyhow::ensure!(
+        !sources.is_empty(),
+        "offline validation requires captured sources"
+    );
+    for source in sources {
+        // The parser canonicalizes each include and checks this same entry
+        // directory before opening it; this second check verifies the files
+        // that were actually captured are still inside the private shadow.
+        let path = std::fs::canonicalize(&source.path)?;
+        anyhow::ensure!(
+            path.starts_with(&config_root),
+            "offline source escapes the private shadow"
+        );
+        let metadata = std::fs::symlink_metadata(&source.path)?;
+        anyhow::ensure!(
+            metadata.file_type().is_file() && metadata.uid() == 0 && metadata.mode() & 0o077 == 0,
+            "offline source file is not private"
+        );
+    }
+    Ok(())
+}
