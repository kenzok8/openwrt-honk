+#[test]
+fn dae_import_replaces_only_business_roots_and_excludes_global_settings() {
+    let existing = managed_source(
+        "include { 'system.dae' }\nglobal { log_level: info }\nnode { old: 'socks5://127.0.0.1:1080' }\nrouting { fallback: direct }\n",
+    );
+    let imported = "global { data_dir: '/tmp/attacker' }\nnode { new: 'trojan://secret@example.test:443#new' }\ngroup { proxy { policy: min_moving_avg } }\ndns { upstream { alidns: 'udp://223.5.5.5:53' } }\n";
+    let (outputs, roots, excluded, replaced) =
+        replace_business_sections_sources(&existing.sources, &[], imported).unwrap();
+    let candidate = &outputs[0].1;
+    assert_eq!(roots, ["node", "group", "dns"]);
+    assert_eq!(excluded, ["global"]);
+    assert_eq!(
+        replaced,
+        [("node".to_owned(), 1), ("routing".to_owned(), 1)]
+    );
+    assert!(candidate.contains("include { 'system.dae' }"));
+    assert!(candidate.contains("global { log_level: info }"));
+    assert!(!candidate.contains("old: 'socks5://127.0.0.1:1080'"));
+    assert!(!candidate.contains("/tmp/attacker"));
+    let loaded = managed_source(&candidate);
+    assert_eq!(loaded.config.nodes[0].name, "new");
+    assert!(
+        loaded
+            .config
+            .groups
+            .iter()
+            .any(|group| group.name == "proxy")
+    );
+
+    let with_include = "include { 'extra.dae' }\nnode { n: 'socks5://127.0.0.1:1081' }";
+    assert!(replace_business_sections_sources(&existing.sources, &[], with_include).is_err());
+
+    let current_tree = parse_dae_sources(
+        &[
+            (
+                PathBuf::from("main.dae"),
+                Arc::from("include { 'extra.dae' }\ninclude { 'system.dae' }\nglobal { log_level: info }\n"),
+            ),
+            (
+                PathBuf::from("extra.dae"),
+                Arc::from("node { old: 'socks5://127.0.0.1:1080' }\ngroup { old: 'old' }\nrouting { fallback: direct }\n"),
+            ),
+            (
+                PathBuf::from("system.dae"),
+                Arc::from("global { data_dir: '/etc/honk' }\n"),
+            ),
+        ],
+        SourceLimits::default(),
+        &mut Vec::new(),
+    )
+    .unwrap();
+    let readonly = vec![PathBuf::from("system.dae")];
+    let (outputs, _, _, replaced) = replace_business_sections_sources(
+        &current_tree.sources,
+        &readonly,
+        "node { new: 'trojan://secret@example.test:443#new' }\nrouting { fallback: block }\n",
+    )
+    .unwrap();
+    assert!(
+        replaced
+            .iter()
+            .any(|(section, count)| section == "node" && *count == 1)
+    );
+    assert!(outputs[0].1.contains("node { new:"));
+    assert!(!outputs[1].1.contains("old: 'socks5://127.0.0.1:1080'"));
+    assert!(outputs[1].1.contains("include") == false);
+    assert_eq!(outputs[2].1, "global { data_dir: '/etc/honk' }\n");
+}
