+/// Clear regenerable Honk state while retaining administrator credentials,
+/// listener secrets, and a fresh pinned default configuration revision.
+pub fn reset_business_state(
+    data_dir: &Path,
+    default_revision: Option<&DefaultRevision>,
+) -> Result<bool, StateError> {
+    let directory = state_directory(data_dir, true, tighten)?;
+    let directory = Flock::lock(directory, FlockArg::LockExclusiveNonblock).map_err(
+        |(_, error)| match error {
+            Errno::EWOULDBLOCK => StateError::InUse,
+            _ => StateError::Unavailable,
+        },
+    )?;
+    match nix::sys::stat::fstatat(
+        &*directory,
+        DB_FILE,
+        nix::fcntl::AtFlags::AT_SYMLINK_NOFOLLOW,
+    ) {
+        Err(Errno::ENOENT) => return Ok(false),
+        Err(error) => return Err(path_error(Target::Database, error)),
+        Ok(_) => {}
+    }
+    let file = existing(&directory)?;
+    tighten(&file, Target::Database)?;
+    let metadata = file.metadata().map_err(|_| StateError::Unavailable)?;
+    drop(file);
+    let path = resolved(&directory)?.join(DB_FILE);
+    let mut connection = open_checked(
+        &path,
+        (metadata.dev(), metadata.ino()),
+        OpenFlags::SQLITE_OPEN_READ_WRITE,
+    )?;
+    check(&connection)?;
+    verify_reset_schema(&connection)?;
+    connection
+        .execute_batch("PRAGMA foreign_keys = ON; PRAGMA synchronous = FULL;")
+        .map_err(sql)?;
+    let transaction = connection
+        .transaction_with_behavior(TransactionBehavior::Immediate)
+        .map_err(sql)?;
+    let revision_count: i64 = transaction
+        .query_row("SELECT count(*) FROM revision", [], |row| row.get(0))
+        .map_err(sql)?;
+    let active: Option<i64> = transaction
+        .query_row("SELECT active FROM head WHERE id=1", [], |row| row.get(0))
+        .optional()
+        .map_err(sql)?;
+    if (revision_count > 0) != active.is_some() {
+        return Err(StateError::Corrupt);
+    }
+    for table in [
+        "subscription_body",
+        "legacy_import",
+        "selector",
+        "delay_sample",
+        "dns_answer",
+        "clash_state",
+        "geodata_settings",
+    ] {
+        transaction
+            .execute(&format!("DELETE FROM {table}"), [])
+            .map_err(sql)?;
+    }
+    if revision_count > 0 {
+        let candidate = default_revision.ok_or(StateError::Unsupported)?;
+        if candidate.root.is_empty()
+            || candidate.sources.len() > 16 * 1024 * 1024
+            || candidate.bytes < 0
+            || crate::configuration::digest(candidate.sources.as_bytes())
+                != candidate.content_sha256
+        {
+            return Err(StateError::Unsupported);
+        }
+        let created_at = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map_or(0, |elapsed| elapsed.as_secs() as i64);
+        transaction
+            .execute(
+                "INSERT INTO revision (parent, created_at, principal, origin, root, sources, content_sha256, bytes)
+                 VALUES (?1, ?2, 'honk-reset', 'import', ?3, ?4, ?5, ?6)",
+                rusqlite::params![
+                    active,
+                    created_at,
+                    candidate.root,
+                    candidate.sources,
+                    candidate.content_sha256,
+                    candidate.bytes,
+                ],
+            )
+            .map_err(sql)?;
+        let new_head = transaction.last_insert_rowid();
+        transaction
+            .execute("UPDATE head SET active=?1 WHERE id=1", [new_head])
+            .map_err(sql)?;
+        transaction
+            .execute("DELETE FROM revision WHERE number != ?1", [new_head])
+            .map_err(sql)?;
+    }
+    transaction.commit().map_err(sql)?;
+    check(&connection)?;
+    connection
+        .query_row("PRAGMA wal_checkpoint(TRUNCATE)", [], |_| Ok(()))
+        .map_err(sql)?;
+    Ok(true)
+}
+
+fn verify_reset_schema(connection: &Connection) -> Result<(), StateError> {
+    if pragma(connection, "application_id")? != APPLICATION_ID
+        || pragma(connection, "user_version")? != SCHEMA_VERSION
+    {
+        return Err(StateError::Unsupported);
+    }
+    let expected = Connection::open_in_memory().map_err(sql)?;
+    expected.execute_batch(SCHEMA).map_err(sql)?;
+    let schema_objects =
+        |connection: &Connection| -> Result<Vec<(String, String, String)>, StateError> {
+            let mut statement = connection
+            .prepare(
+                "SELECT type, name, sql FROM sqlite_schema WHERE name NOT LIKE 'sqlite_%' ORDER BY type, name",
+            )
+            .map_err(sql)?;
+            let rows = statement
+                .query_map([], |row| {
+                    Ok((
+                        row.get::<_, String>(0)?,
+                        row.get::<_, String>(1)?,
+                        row.get::<_, String>(2)?,
+                    ))
+                })
+                .map_err(sql)?;
+            rows.collect::<Result<Vec<_>, _>>().map_err(sql)
+        };
+    let normalize = |objects: Vec<(String, String, String)>| {
+        objects
+            .into_iter()
+            .map(|(kind, name, sql)| {
+                (
+                    kind,
+                    name,
+                    sql.split_whitespace().collect::<Vec<_>>().join(" "),
+                )
+            })
+            .collect::<Vec<_>>()
+    };
+    if normalize(schema_objects(connection)?) != normalize(schema_objects(&expected)?) {
+        return Err(StateError::Unsupported);
+    }
+    Ok(())
+}
